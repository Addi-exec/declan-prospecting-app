{
  "name": "declan-prospecting-app",
  "version": "1.3.0",
  "description": "Prospecting scripts and contact tracker for real estate cold calling.",
  "author": "Declan Addison",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "release": "electron-builder --publish always"
  },
  "devDependencies": {
    "electron": "^42.3.3",
    "electron-builder": "^26.15.0"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "exceljs": "^4.4.0",
    "googleapis": "^173.0.0"
  },
  "build": {
    "appId": "com.declanaddison.prospecting",
    "productName": "Declan Prospecting App",
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.business",
      "icon": "assets/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Declan Prospecting App"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Office",
      "maintainer": "Declan Addison <declan@declanprospecting.app>",
      "synopsis": "Prospecting scripts and contact tracker for real estate cold calling.",
      "desktop": {
        "Name": "Declan Prospecting App",
        "Comment": "Prospecting scripts and contact tracker"
      }
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Addi-exec",
        "repo": "declan-prospecting-app",
        "releaseType": "release"
      }
    ]
  }
}
